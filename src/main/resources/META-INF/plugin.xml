<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.vhrabar.pyprojecthub</id>
    <name>PyProjectHub</name>
    <vendor url="https://github.com/vhrabar">Vedran Hrabar</vendor>
    <!-- <description> and <change-notes> are injected at build time from README.md and CHANGELOG.md -->

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>

    <resource-bundle>messages.PyProjectHubBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            id="com.github.vhrabar.pyprojecthub.settings"
            parentId="tools"
            instance="com.github.vhrabar.pyprojecthub.settings.PyProjectHubConfigurable"
            key="settings.displayName"/>
    </extensions>

    <actions resource-bundle="messages.PyProjectHubBundle">
        <action
            id="PyProjectHub.OpenBrowser"
            class="com.github.vhrabar.pyprojecthub.ui.OpenProjectBrowserAction"
            icon="/icons/pyProjectHub.svg">
            <add-to-group group-id="WelcomeScreen.QuickStart" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
